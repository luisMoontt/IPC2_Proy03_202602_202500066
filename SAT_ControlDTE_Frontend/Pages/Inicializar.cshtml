@page
@model InicializarModel
@{
    ViewData["Title"] = "Inicializar sistema";
}


<div class="card">
    <div class="card-body">
        <p>Esta opcion le pide a la API que borre <strong>todos</strong> los datos: contribuyentes del RTU,
            facturas, errores y correlativos. El sistema queda como recien instalado.</p>
        <form method="post" onsubmit="return confirm('Se borraran todos los datos. ¿Desea continuar?');">
            <button class="btn btn-danger" type="submit">Inicializar</button>
        </form>
    </div>
</div>

@if (Model.Mensaje != null)
{
    <div class="alert alert-success mt-3">@Model.Mensaje</div>
}
@if (Model.Error != null)
{
    <div class="alert alert-danger mt-3">@Model.Error</div>
}
