@page
@inject IConfiguration Configuracion
@{
    ViewData["Title"] = "Guía del sistema";
    string apiUrl = (Configuracion["ApiUrl"] ?? "").TrimEnd('/');
}

<header class="pagina-encabezado">
    <h1>Guía del sistema</h1>
    <p>Cómo está organizado el programa y qué servicios ofrece la API SAT_ControlDTE</p>
</header>

<div class="pila">
    <div class="card">
        <div class="card-body">
            <p>
                Este sitema se compone de 2 partes, una programa que ejecuta y le da hosting a la api del programa SAT_ControlDTE_Backend y el otro que le da soporte a la pated del frontend SAT_ControlDTE_Frontend.
            </p>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h2 class="card-titulo"><i class="fas fa-plug me-2"></i>Servicios de la API AT_ControlDTE_Backen</h2></div>
        <div class="card-body">
            <p class="mb-3">Dirección de la API: <code>@apiUrl</code></p>
            <div class="table-responsive">
                <table class="table">
                    <thead><tr><th>Método</th><th>Ruta</th><th>Qué hace</th></tr></thead>
                    <tbody>
                        <tr><td><span class="metodo metodo-post">POST</span></td><td><code>/api/rtu</code></td><td>Registra o modifica la información de contribuyentes en el RTU</td></tr>
                        <tr><td><span class="metodo metodo-get">GET</span></td><td><code>/api/rtu</code></td><td>Obtiene el listado de contribuyentes registrados</td></tr>
                        <tr><td><span class="metodo metodo-post">POST</span></td><td><code>/api/autorizaciones</code></td><td>Valida las facturas y emite sus respectivos códigos de autorización</td></tr>
                        <tr><td><span class="metodo metodo-get">GET</span></td><td><code>/api/consultas/contribuyente</code></td><td>Consulta facturas emitidas o recibidas asociadas a un NIT (parámetros: nit, tipo, desde, hasta)</td></tr>
                        <tr><td><span class="metodo metodo-get">GET</span></td><td><code>/api/consultas/iva</code></td><td>Reporte diario del IVA emitido y recibido para un NIT específico (parámetro: fecha)</td></tr>
                        <tr><td><span class="metodo metodo-get">GET</span></td><td><code>/api/consultas/rango</code></td><td>Totales autorizados por día, desglosados con y sin IVA (parámetros: desde, hasta)</td></tr>
                        <tr><td><span class="metodo metodo-get">GET</span></td><td><code>/api/consultas/errores</code></td><td>Listado por fecha de facturas procesadas que presentaron errores (parámetros: desde, hasta)</td></tr>
                        <tr><td><span class="metodo metodo-post">POST</span></td><td><code>/api/inicializar</code></td><td>Restablece el sistema eliminando toda la base de datos</td></tr>
                        <tr><td><span class="metodo metodo-get">GET</span></td><td><code>/api/estado</code></td><td>Verifica el estado operativo y la disponibilidad del servicio</td></tr>
                                            </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
