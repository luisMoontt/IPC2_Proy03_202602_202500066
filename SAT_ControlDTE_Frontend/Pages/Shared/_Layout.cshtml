@{
    // Pagina actual, para marcar en el menu lateral la opcion activa
    string actual = ViewContext.RouteData.Values["page"] as string ?? "";
    Func<string, string> activo = pagina => actual == pagina ? "active" : "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SAT DTE</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div id="contenedor">

        <nav id="menuLateral" class="menu-lateral">
            <a class="menu-marca" asp-page="/Index">
                <i class="fas fa-file-invoice-dollar"></i>
                <span>SAT · DTE</span>
            </a>

            <hr />
            <a class="menu-enlace @activo("/Index")" asp-page="/Index">
                <i class="fas fa-fw fa-home"></i><span>Inicio</span>
            </a>

            <hr />
            <div class="menu-titulo">Mensajes</div>
            <a class="menu-enlace @activo("/Enviar")" asp-page="/Enviar">
                <i class="fas fa-fw fa-paper-plane"></i><span>Enviar mensaje</span>
            </a>

            <hr />
            <div class="menu-titulo">Peticiones</div>
            <a class="menu-enlace @activo("/Consultas/Contribuyente")" asp-page="/Consultas/Contribuyente">
                <i class="fas fa-fw fa-user-tie"></i><span>Consultar contribuyente</span>
            </a>
            <a class="menu-enlace @activo("/Consultas/Iva")" asp-page="/Consultas/Iva">
                <i class="fas fa-fw fa-percent"></i><span>Resumen de IVA</span>
            </a>
            <a class="menu-enlace @activo("/Consultas/Rango")" asp-page="/Consultas/Rango">
                <i class="fas fa-fw fa-chart-bar"></i><span>Resumen por rango</span>
            </a>
            <a class="menu-enlace @activo("/Consultas/Errores")" asp-page="/Consultas/Errores">
                <i class="fas fa-fw fa-exclamation-triangle"></i><span>Reporte de errores</span>
            </a>

            <hr />
            <div class="menu-titulo">Ayuda</div>
            <a class="menu-enlace @activo("/Ayuda/Estudiante")" asp-page="/Ayuda/Estudiante">
                <i class="fas fa-fw fa-user-graduate"></i><span>Estudiante</span>
            </a>
            <a class="menu-enlace @activo("/Ayuda/Documentacion")" asp-page="/Ayuda/Documentacion">
                <i class="fas fa-fw fa-book"></i><span>Documentacion</span>
            </a>

            <hr />
            <div class="menu-titulo">Sistema</div>
            <a class="menu-enlace @activo("/Inicializar")" asp-page="/Inicializar">
                <i class="fas fa-fw fa-trash-restore"></i><span>Inicializar</span>
            </a>

            <hr class="d-none d-md-block" />
            <div class="text-center d-none d-md-block">
                <button type="button" id="botonMenu" class="boton-menu" title="Contraer menu" onclick="alternarMenu()">
                    <i class="fas fa-angle-left"></i>
                </button>
            </div>
        </nav>

        <div id="contenido" class="d-flex flex-column">
            <nav class="barra-superior">
                <button type="button" class="btn btn-link d-md-none me-2 p-0" onclick="alternarMenu()" title="Menu">
                    <i class="fas fa-bars"></i>
                </button>
                <h1 class="h5 mb-0 text-gray">@ViewData["Title"]</h1>
                <span class="ms-auto text-gray small d-none d-sm-inline">
                    <i class="fas fa-user-circle me-1"></i>Andres Fernando Corado Cux - 202503756
                </span>
            </nav>

            <main class="container-fluid px-4 pb-4 flex-grow-1">
                @RenderBody()
            </main>

            <footer class="pie">
                | IPC2 | Proyecto 3 | 2S2026 | (https://github.com/NanDo-ssj/IPC2_Proy03_202602_202503756) |
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jspdf/jspdf.umd.min.js"></script>
    <script src="~/lib/jspdf/jspdf.plugin.autotable.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
