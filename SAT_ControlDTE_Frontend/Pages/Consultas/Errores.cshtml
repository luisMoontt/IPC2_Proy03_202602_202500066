@page
@model ErroresModel
@{
    ViewData["Title"] = "Errores en facturas recibidas";
}

<header class="pagina-encabezado">
    <h1>Errores en facturas recibidas</h1>
    <p>Consulta cuántas facturas llegaron cada día y qué problemas de validación presentaron.</p>
</header>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="filtros">
            <div>
                <label class="form-label" asp-for="Desde">Desde</label>
                <input class="form-control" asp-for="Desde" />
            </div>
            <div>
                <label class="form-label" asp-for="Hasta">Hasta</label>
                <input class="form-control" asp-for="Hasta" />
            </div>
            <div>
                <button class="btn btn-primary w-100" type="submit">Consultar</button>
            </div>
        </form>
    </div>
</div>

@if (Model.Error != null)
{
    <div class="alert alert-warning">@Model.Error</div>
}

@if (Model.Resultado == null && Model.Error == null)
{
    <div class="vacio">
        <i class="fas fa-exclamation-triangle"></i>
        <p>Elige el rango de fechas y pulsa «Consultar» para revisar los errores detectados.</p>
    </div>
}

@if (Model.Resultado != null)
{
    ReporteErrores r = Model.Resultado;
    string subtitulo = $"Periodo: {r.Desde} a {r.Hasta}";

    <div class="card">
        <div class="card-body">
            <div class="resultado-encabezado">
                <div>
                    <h2>Facturas recibidas por fecha</h2>
                    <div class="meta">Del @r.Desde al @r.Hasta.</div>
                </div>
                @if (r.Fechas.Count > 0)
                {
                    <button class="btn btn-outline-secondary btn-sm" type="button" data-subtitulo="@subtitulo"
                            onclick="generarPdf({ titulo: 'Reporte de facturas recibidas y errores', subtitulo: this.dataset.subtitulo, archivo: 'reporte_errores.pdf', tablas: ['tablaErrores'], horizontal: true })">
                        <i class="fas fa-download me-1"></i>Descargar PDF
                    </button>
                }
            </div>

            @if (r.Fechas.Count == 0)
            {
                <div class="alert alert-info mb-0">No se recibieron facturas en el rango elegido.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table" id="tablaErrores">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th class="num">Facturas recibidas</th>
                                <th class="num">NIT emisor inválido</th>
                                <th class="num">NIT receptor inválido</th>
                                <th class="num">NIT emisor inexistente</th>
                                <th class="num">NIT receptor inexistente</th>
                                <th class="num">IVA mal calculado</th>
                                <th class="num">Total mal calculado</th>
                                <th class="num">Referencia duplicada</th>
                                <th class="num">Facturas sin errores</th>
                                <th class="num">Emisores</th>
                                <th class="num">Receptores</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (ErroresPorFecha d in r.Fechas)
                            {
                                <tr>
                                    <td>@d.Fecha</td>
                                    <td class="num">@d.CantidadFacturasRecibidas</td>
                                    <td class="num">@d.Errores.NitEmisorInvalido</td>
                                    <td class="num">@d.Errores.NitReceptorInvalido</td>
                                    <td class="num">@d.Errores.NitEmisorInexistente</td>
                                    <td class="num">@d.Errores.NitReceptorInexistente</td>
                                    <td class="num">@d.Errores.IvaMalCalculado</td>
                                    <td class="num">@d.Errores.TotalMalCalculado</td>
                                    <td class="num">@d.Errores.ReferenciaDuplicada</td>
                                    <td class="num">@d.CantidadFacturasSinErrores</td>
                                    <td class="num">@d.CantidadEmisores</td>
                                    <td class="num">@d.CantidadReceptores</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}
