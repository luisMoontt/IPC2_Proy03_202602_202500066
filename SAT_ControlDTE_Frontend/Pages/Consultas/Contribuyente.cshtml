@page
@model ContribuyenteModel
@{
    ViewData["Title"] = "Consulta por contribuyente";
}

<header class="pagina-encabezado">
    <h1>Consulta por contribuyente</h1>
    <p>Revisa las facturas que un NIT emitió o recibió durante el periodo que elijas.</p>
</header>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="filtros">
            <div>
                <label class="form-label" asp-for="Nit">NIT</label>
                <input class="form-control" asp-for="Nit" placeholder="Ej. 999999K" />
            </div>
            <div>
                <label class="form-label d-block">Tipo de factura</label>
                <div class="segmentado">
                    <input type="radio" asp-for="Tipo" value="emitidas" id="emitidas" />
                    <label for="emitidas">Emitidas</label>
                    <input type="radio" asp-for="Tipo" value="recibidas" id="recibidas" />
                    <label for="recibidas">Recibidas</label>
                </div>
            </div>
            <div>
                <label class="form-label" asp-for="Desde">Desde</label>
                <input class="form-control" asp-for="Desde" />
            </div>
            <div>
                <label class="form-label" asp-for="Hasta">Hasta</label>
                <input class="form-control" asp-for="Hasta" />
            </div>
            <div>
                <button class="btn btn-primary w-100" type="submit">Consultar</button>
            </div>
        </form>
    </div>
</div>

@if (Model.Error != null)
{
    <div class="alert alert-warning">@Model.Error</div>
}

@if (Model.Resultado == null && Model.Error == null)
{
    <div class="vacio">
        <i class="fas fa-search"></i>
        <p>Escribe un NIT, elige el periodo y pulsa «Consultar» para ver sus facturas.</p>
    </div>
}

@if (Model.Resultado != null)
{
    ConsultaContribuyente r = Model.Resultado;
    string titulo = $"Facturas {r.Tipo} de {r.Nombre} (NIT {r.Nit})";
    string subtitulo = $"Periodo: {r.Desde} a {r.Hasta}";

    <div class="card">
        <div class="card-body">
            <div class="resultado-encabezado">
                <div>
                    <h2>Facturas @r.Tipo</h2>
                    <div class="meta">@r.Nombre, NIT @r.Nit. Del @r.Desde al @r.Hasta.</div>
                </div>
                <button class="btn btn-outline-secondary btn-sm" type="button" data-titulo="@titulo" data-subtitulo="@subtitulo"
                        onclick="generarPdf({ titulo: this.dataset.titulo, subtitulo: this.dataset.subtitulo, archivo: 'consulta_contribuyente.pdf', tablas: ['tablaResumen', 'tablaDetalle'] })">
                    <i class="fas fa-download me-1"></i>Descargar PDF
                </button>
            </div>

            @if (r.CantidadFacturas == 0)
            {
                <div class="alert alert-info mb-0">No encontramos facturas autorizadas para este NIT en el periodo elegido.</div>
            }
            else
            {
                <h3 class="subtitulo-seccion">Totales por fecha</h3>
                <div class="tabla-scroll">
                    <table class="table" id="tablaResumen">
                        <thead>
                            <tr><th>Fecha</th><th class="num">Facturas autorizadas</th><th class="num">Monto facturado</th></tr>
                        </thead>
                        <tbody>
                            @foreach (TotalPorFecha fila in r.Fechas)
                            {
                                <tr><td>@fila.Fecha</td><td class="num">@fila.CantidadFacturas</td><td class="num">Q @fila.MontoTotal.ToString("N2")</td></tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr><td>Total del periodo</td><td class="num">@r.CantidadFacturas</td><td class="num">Q @r.MontoTotal.ToString("N2")</td></tr>
                        </tfoot>
                    </table>
                </div>

                <h3 class="subtitulo-seccion separado">Detalle de facturas</h3>
                <div class="table-responsive">
                    <table class="table" id="tablaDetalle">
                        <thead>
                            <tr>
                                <th>Fecha</th><th>Referencia</th><th>NIT emisor</th><th>NIT receptor</th>
                                <th class="num">Valor</th><th class="num">IVA</th><th class="num">Total</th><th>Código de aprobación</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (FacturaDetalle f in r.Facturas)
                            {
                                <tr>
                                    <td>@f.Fecha</td><td>@f.Referencia</td><td>@f.NitEmisor</td><td>@f.NitReceptor</td>
                                    <td class="num">@f.Valor.ToString("N2")</td><td class="num">@f.Iva.ToString("N2")</td>
                                    <td class="num">@f.Total.ToString("N2")</td><td>@f.CodigoAprobacion</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}
